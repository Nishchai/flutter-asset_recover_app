{
  "appName": "Asset Recovery",
  "appTagline": "Field Agent",
  "_comment_appVersion": "Reported as `appVersion` on every audit-log entry. Keep it in step with pubspec.yaml's `version:` (the app has no package_info plugin, so this is the only place the running build knows its own version from).",
  "appVersion": "1.0.3",
  "defaultEnvironment": "prod",

  "business": {
    "slaDays": 90,
    "slaWarnDays": 7,
    "ticketIdPrefix": "TKT",
    "bpIdPrefix": "BP",
    "caseIdPrefix": "AAR",
    "customerRemarkRequiredForRefusal": true,
    "autoExpireNoActionDays": 90,
    "routeTrackingIntervalSeconds": 30,
    "routeTrackingMinDistanceMeters": 50,
    "routeTrackingMaxPoints": 500,
    "notReturnedWarningDays": 20,
    "nearbyPickupRadiusKm": 8
  },

  "session": {
    "autoLogoutHours": 12,
    "warnBeforeLogoutMinutes": 5,
    "requireReauthOnResume": false
  },

  "location": {
    "geofenceRadiusMeters": 50,
    "enforceGeofenceOnRecovery": false,
    "requireLocationServicesOn": true,
    "distanceProvider": "google_road",
    "allowManualDistanceRefresh": true,
    "gpsAccuracyThresholdMeters": 30,
    "_comment_reportIntervalMinutes": "How often the app PATCHes the agent's current device coordinates to /agents/location while it is in the foreground. The heartbeat pauses when the app is backgrounded (there is no background location permission) and fires once immediately on resume. 0 disables the heartbeat — the landing-triggered reports still happen.",
    "reportIntervalMinutes": 5
  },

  "proof": {
    "mandatoryForCall": true,
    "mandatoryForVisit": true,
    "mandatoryForHomeVisit": true,
    "mandatoryForRecovery": true,
    "autoEmbedGpsTimestamp": true,
    "allowRetake": true,
    "imageMaxSizeMb": 5,
    "imageMinWidthPx": 640
  },

  "qr": {
    "enabled": true,
    "validateAgainstAssignedBp": true,
    "blockOnMismatch": true
  },

  "features": {
    "inAppCalling": true,
    "callingProvider": "ozonetel",
    "callRecording": true,
    "mapView": true,
    "inAppMapNavigation": true,
    "storeHandoverOtp": true,
    "firDocumentUpload": true,
    "firDocumentMandatory": true,
    "customerDetailUpdate": true,
    "multiLanguage": true,
    "offlineQueue": true,
    "auditLogging": true,
    "riskVisibility": true,
    "actualRouteCapture": true,
    "compressUploads": true
  },

  "taskList": {
    "_comment_pageSize": "Tickets fetched per request by the home list (GET /tickets?page=&pageSize=). The list appends the next page as the agent scrolls to the end of the loaded ones.",
    "pageSize": 20,
    "defaultSort": "distance",
    "availableSorts": ["distance", "pendingDuration", "slaRemaining"],
    "segments": ["all_tasks", "in_progress", "completed"]
  },

  "navigation": {
    "items": [
      { "id": "tasks", "labelKey": "nav.tasks", "icon": "checklist" },
      { "id": "map", "labelKey": "nav.map", "icon": "map" },
      { "id": "profile", "labelKey": "nav.profile", "icon": "person" }
    ]
  },

  "localization": {
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "hi", "ta", "te", "kn", "mr"]
  }
}
